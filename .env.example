# One root configuration file. Never commit .env or paste credentials into chat.
OPENAI_API_KEY=your_openai_key_here
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# One runtime serves the PANINI shell, the web console (FRONTEND_PORT) and the
# browser extension. The shell and `npm run dev` both read these ports.
FRONTEND_PORT=3200
BACKEND_PORT=8200
SEARCH_PORT=3230
BROWSER_HEADLESS=false
# OpenAI model used for extension task planning and page-grounded proposals.
EXTENSION_PLANNER_MODEL=gpt-4.1-2025-04-14
# Native speech-to-speech conversation, using the same OPENAI_API_KEY.
VOICE_MODEL=gpt-live-1
VOICE_NAME=marin
# Maximum connected audio session duration, in seconds; reconnect to continue.
VOICE_SESSION_SECONDS=3600
# ALLOWED_ORIGINS=http://localhost:3000
# Where pairings and the runtime discovery file live (default: %LOCALAPPDATA%\PANINI).
# PANINI_DATA_DIR=C:/Users/your-user/AppData/Local/PANINI

# Agent harness: memory, skills, conversations and background tasks (local SQLite).
# Set to 0 to disable. The agent model defaults to the CLI/code model chain.
# PANINI_HARNESS_ENABLED=1
# PANINI_AGENT_MODEL=gpt-4.1
# PANINI Code: run commands in a Docker container (no network, workspace only).
# PANINI_CLI_SANDBOX=native  # Windows default; fail-closed if unavailable
# PANINI_CLI_SANDBOX=docker  # optional external adapter
# PANINI_CLI_SANDBOX_IMAGE=python:3.12-slim

# Desktop is enabled automatically when the PANINI shell runs (it starts the Windows companion).
# Every application is a valid Desktop target. To restrict it, list process names:
# PANINI_DESKTOP_APPS=notepad,mspaint
# The large on-screen cursor that shows what PANINI is doing (set to 0 to turn it off).
# PANINI_DESKTOP_OVERLAY=1
# Faint labelled coordinate grid on the planner's screenshot (helps precise clicks and drawing).
# PANINI_DESKTOP_GRID=1
# File and command tools cover every local drive. Set to restricted for home and workspaces only.
# PANINI_COMPUTER_ACCESS=full
# Use the screenshot-aware action loop (0 selects the UIA-only loop).
PANINI_DESKTOP_VISUAL=1
# Set to 0 to disable short, static, non-activating action feedback.
PANINI_DESKTOP_FEEDBACK=1
# Optional coding capability. Workspaces are explicitly configured existing project directories.
# `npm run panini:code` enables it for one launch.
PANINI_CLI_ENABLED=false
PANINI_CLI_WORKSPACES=[]
# PANINI-CLI accepts any OpenAI model id your key can use.
# Fallback order: PANINI_CLI_MODEL, JEV_REV_CODE_MODEL, PANINI_AGENT_MODEL,
# PANINI_PLANNER_MODEL, EXTENSION_PLANNER_MODEL, then gpt-4.1.
JEV_REV_CODE_MODEL=gpt-4.1
PANINI_CLI_MODEL=
PANINI_CLI_REASONING_EFFORT=low
# Coding uses PANINI Code (panini-cli) with OPENAI_API_KEY. To use another
# app-server-compatible runtime instead (for example the Codex CLI and its OS sandbox):
# PANINI_CLI_EXECUTABLE=C:/path/to/codex.exe
# PANINI_CLI_DATA=C:/Users/your-user/AppData/Local/PANINI/code
