      "input_schema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^a[0-9]+$",
            "maxLength": 30
          },
          "direction": {
            "type": "string",
            "enum": ["up", "down", "left", "right"]
          }
        },
        "required": ["ref", "direction"],
        "additionalProperties": false
      },
      "effect": "navigate",
      "dynamic_effect": true,
      "concurrency": "android",
      "timeout_ms": 60000,
      "requires": ["android", "foreground"],
      "taints": ["android"],
      "evidence": [],
      "order": 188
    },
    {
      "name": "android_launch",
      "hand": "android",
      "title": "Launch",
