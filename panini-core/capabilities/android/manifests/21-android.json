            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": ["url"],
        "additionalProperties": false
      },
      "effect": "navigate",
      "dynamic_effect": true,
      "concurrency": "android",
      "timeout_ms": 60000,
      "requires": ["android", "foreground"],
      "taints": ["android"],
      "evidence": [],
      "order": 190
    },
    {
      "name": "android_verify_text",
      "hand": "android",
