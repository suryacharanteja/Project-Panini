            "maxLength": 30
          },
          "text": {
            "type": "string",
            "maxLength": 10000
          }
        },
        "required": ["ref", "text"],
        "additionalProperties": false
      },
      "effect": "input",
      "dynamic_effect": true,
      "concurrency": "android",
      "timeout_ms": 60000,
      "requires": ["android", "foreground"],
      "taints": ["android"],
      "evidence": [],
      "order": 185
    },
    {
      "name": "android_press",
      "hand": "android",
      "title": "Press",
      "description": "Press a fixed key; Enter requires submission policy and a unique focused field.",
      "input_schema": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": ["BACK", "HOME", "ENTER", "TAB", "DEL", "ESCAPE", "DPAD_UP", "DPAD_DOWN"]
