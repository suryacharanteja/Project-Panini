          "direction": {
            "type": "string",
            "enum": ["up", "down", "left", "right"]
          }
        },
        "required": ["ref", "direction"],
        "additionalProperties": false
      },
      "effect": "navigate",
      "dynamic_effect": true,
      "concurrency": "android",
      "timeout_ms": 60000,
      "requires": ["android", "foreground"],
      "taints": ["android"],
      "evidence": [],
      "order": 187
    },
    {
      "name": "android_scroll",
      "hand": "android",
      "title": "Scroll",
