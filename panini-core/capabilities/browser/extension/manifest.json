{
  "manifest_version": 3,
  "name": "JevRev Claw — Browser Extension",
  "version": "3.2.0",
  "description": "The browser capability of PANINI. Pair once, attach the tabs you choose, and stay in control of every action.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "optional_permissions": ["tabGroups"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JevRev Claw",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
