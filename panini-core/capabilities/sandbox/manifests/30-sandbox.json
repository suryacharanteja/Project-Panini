        "sandbox"
      ],
      "order": 126,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_click",
      "hand": "sandbox",
      "title": "Click in the sandbox",
      "description": "Click an element using its s-ref and snapshotId from the latest sandbox_snapshot.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "description": "s-ref from the latest sandbox_snapshot."
          },
          "snapshotId": {
            "type": "integer",
            "description": "snapshotId from that sandbox_snapshot."
          }
        },
        "required": [
          "ref",
          "snapshotId"
        ]
      },
      "effect": "submit",
      "group": "sandbox_browser",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 127,
      "dynamic_effect": true
    },
    {
      "name": "sandbox_type",
      "hand": "sandbox",
      "title": "Type in the sandbox",
      "description": "Type text into an element using its latest s-ref; submit presses Enter afterwards.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string",
            "description": "s-ref from the latest sandbox_snapshot."
          },
          "snapshotId": {
            "type": "integer",
            "description": "snapshotId from that sandbox_snapshot."
          },
          "text": {
            "type": "string"
          },
          "submit": {
            "type": "boolean"
          }
        },
        "required": [
          "ref",
          "snapshotId",
          "text",
          "submit"
        ]
      },
      "effect": "input",
      "group": "sandbox_browser",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 128,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_key",
