{
  "schema": "panini.capability/1",
  "id": "sandbox",
  "title": "Sandbox computer",
  "version": "1.0.0",
  "summary": "PANINI's own isolated, persistent computer on Docker: a browser, a workspace folder and a shell, apart from this PC.",
  "entry": "backend.hands.sandbox:SandboxHand",
  "prompt": {
    "principles": [
      "Use the sandbox (sandbox_*) for untrusted links, unknown downloads and experimental code; this PC stays the trusted computer.",
      "Act on refs and the snapshotId from the latest sandbox_snapshot; after HTTP 409 take a new snapshot, and never work around the owner's take-over.",
      "Nothing falls back to this PC when the sandbox is unavailable: say so instead."
    ]
  },
  "tools": [
    {
      "name": "sandbox_status",
      "hand": "sandbox",
      "title": "Sandbox status",
      "description": "Whether PANINI's sandbox computer is set up, stopped or running, its permissions and who controls its browser.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "effect": "observe",
      "group": "sandbox_lifecycle",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 120,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_start",
      "hand": "sandbox",
      "title": "Start the sandbox",
      "description": "Start PANINI's isolated sandbox computer (a container with a browser, a workspace folder and a shell). Files and browser logins persist.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "effect": "local_exec",
      "group": "sandbox_lifecycle",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 121,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_stop",
      "hand": "sandbox",
      "title": "Stop the sandbox",
      "description": "Stop the sandbox computer. Its files and browser profile are kept.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "effect": "local_exec",
      "group": "sandbox_lifecycle",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 122,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_navigate",
      "hand": "sandbox",
      "title": "Open a page in the sandbox",
      "description": "Open a web address in the sandbox browser (isolated from this PC). Use it for untrusted links and unknown sites.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "effect": "navigate",
      "group": "sandbox_browser",
      "taints": [
        "web"
      ],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 123,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_read",
      "hand": "sandbox",
      "title": "Read the sandbox page",
      "description": "Read the text of the page in the sandbox browser.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "effect": "observe",
      "group": "sandbox_browser",
      "taints": [
        "web"
      ],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 124,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_snapshot",
      "hand": "sandbox",
      "title": "Snapshot the sandbox page",
