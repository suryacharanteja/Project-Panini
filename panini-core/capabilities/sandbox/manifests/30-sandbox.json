          }
        },
        "required": [
          "key"
        ]
      },
      "effect": "input",
      "group": "sandbox_browser",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 129,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_scroll",
      "hand": "sandbox",
      "title": "Scroll the sandbox page",
      "description": "Scroll the sandbox browser by deltaY pixels (-10000 to 10000).",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deltaY": {
            "type": "number"
          }
        },
        "required": [
          "deltaY"
        ]
      },
      "effect": "navigate",
      "group": "sandbox_browser",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 130,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_files_list",
      "hand": "sandbox",
      "title": "List sandbox files",
      "description": "List files in the sandbox workspace folder ('' for the top).",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the sandbox workspace, without '..'."
          }
        },
        "required": [
          "path"
        ]
      },
      "effect": "observe",
      "group": "sandbox_files",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 131,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_files_read",
      "hand": "sandbox",
      "title": "Read a sandbox file",
      "description": "Read a text file from the sandbox workspace.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the sandbox workspace, without '..'."
          }
        },
        "required": [
          "path"
        ]
      },
      "effect": "observe",
      "group": "sandbox_files",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 132,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_files_write",
      "hand": "sandbox",
      "title": "Write a sandbox file",
      "description": "Write (or append to) a text file in the sandbox workspace, at most 100,000 characters. It stays inside the sandbox.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "Path relative to the sandbox workspace, without '..'."
