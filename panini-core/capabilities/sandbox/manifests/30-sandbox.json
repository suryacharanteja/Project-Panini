      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "effect": "observe",
      "group": "sandbox_browser",
      "taints": [
        "web"
      ],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 125,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_screenshot",
      "hand": "sandbox",
      "title": "Sandbox screenshot",
      "description": "Take a screenshot of the sandbox browser.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "effect": "observe",
      "group": "sandbox_browser",
      "taints": [
        "web"
      ],
      "timeout_ms": 90000,
