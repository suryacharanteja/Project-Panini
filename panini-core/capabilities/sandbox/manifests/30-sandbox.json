        "sandbox"
      ],
      "order": 133,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_exec",
      "hand": "sandbox",
      "title": "Run a command in the sandbox",
      "description": "Run a shell command inside the sandbox computer (not on this PC), 1-60 s (timeoutMs 1000-60000). Use it for experimental or untrusted code.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string"
          },
          "timeoutMs": {
            "type": "integer"
          }
        },
        "required": [
          "command",
          "timeoutMs"
        ]
      },
      "effect": "local_exec",
      "group": "sandbox_shell",
      "taints": [],
      "timeout_ms": 90000,
      "concurrency": "sandbox",
      "requires": [
        "sandbox"
      ],
      "order": 134,
      "dynamic_effect": false
    },
    {
      "name": "sandbox_import",
      "hand": "sandbox",
      "title": "Copy a file into the sandbox",
      "description": "Copy a text file from this PC (absolute host_path, up to 100 KB, never secrets) into the sandbox workspace at dest ('' keeps the name).",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
