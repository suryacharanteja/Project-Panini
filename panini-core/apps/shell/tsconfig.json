{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "allowJs": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM"], "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.mjs"]
}
